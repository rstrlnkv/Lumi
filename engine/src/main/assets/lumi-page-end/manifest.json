{
  "manifest_version": 2,
  "name": "Lumi page end",
  "version": "1.4",
  "description": "Adds a block the height of Lumi's bottom strip at the end of every page that scrolls.",
  "browser_specific_settings": { "gecko": { "id": "page-end@lumi.digitalpunk.ru" } },
  "permissions": ["geckoViewAddons", "nativeMessaging", "storage"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "css": ["spacer.css"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false,
    "match_about_blank": false
  }]
}
